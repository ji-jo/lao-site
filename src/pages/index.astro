---
import Base from '../layouts/Base.astro';
import CloudShader from '../components/backgrounds/CloudShader';
import WaveShaderBackground from '../components/backgrounds/WaveShaderBackground';
import BlurEffect from 'react-progressive-blur';
import { GooeyInput } from '../components/ui/gooey-input';
import HighlighterDock from '../components/HighlighterDock';
import Footer from '../components/Footer.tsx';
import { MusicToggleButton } from '../components/MusicToggleButton.tsx';
import { GradientHoverButton } from '../components/ui/GradientHoverButton.tsx';
import ThreeScrollCards from '../components/ThreeScrollCards';
import MacbookScrollDemo from '@/components/MacbookScrollDemo';
import HowItWorks from '@/components/ui/how-it-works';
import ModeCubeSection from '@/components/ModeCubeSection';
import PicturaAudienceSection from '@/components/PicturaAudienceSection';
import wordmarkUrl from '../../assets/wordmark.svg?url';
import palmUrl from '../../assets/palm.svg?url';
---

<Base title="LAO Waitlist">
  <div id="main-app" class="relative bg-ink-900 font-body text-text overflow-x-clip">

    <div class="fixed top-0 left-0 right-0 h-[120px] z-40">
      <BlurEffect position="top" intensity={50} className="h-full" />
    </div>

    <HighlighterDock client:only="react" />

    <nav id="main-nav" class="fixed top-[20px] left-1/2 -translate-x-1/2 z-50 flex items-center justify-between gap-6 w-[min(640px,calc(100vw-40px))] py-[9px] pr-[10px] pl-[24px] rounded-full bg-ink-800/78 backdrop-blur-md shadow-[0_18px_50px_-20px_rgba(0,0,0,.85)] transition-all duration-[260ms] ease-[cubic-bezier(0.4,0,0.2,1)]">
      <img src={wordmarkUrl} alt="LAO" class="w-[44px] h-[29px] invert brightness-150" />
      <div class="flex-1 flex justify-center">
        <MusicToggleButton client:only="react" />
      </div>
      <GradientHoverButton
        client:load
        href="#waitlist"
        background="linear-gradient(in oklab 180deg, oklab(0% 0 0) 0%, oklab(48.5% -0.018 -0.082) 100%)"
        hoverBackground="linear-gradient(in oklab 180deg, oklab(10% 0 -0.01) 0%, oklab(58% -0.03 -0.13) 100%)"
        borderColor="#292A2A"
        hoverBorderColor="#363636"
        className="py-[10px] px-[22px] rounded-full text-text-hi font-display text-[19px] focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-3"
      >
        Join Waitlist
      </GradientHoverButton>
    </nav>

    <!-- Keep the sticky laptop above the following story panel while its
         display is still opening/holding in the viewport. -->
    <section data-hero-wave-stage class="relative z-20 bg-ink-900 overflow-visible">
      <div class="pointer-events-none absolute top-0 left-1/2 z-10 h-[800px] w-[min(1200px,100%)] -translate-x-1/2 overflow-hidden rounded-bl-[24px] rounded-br-[24px]">
        <CloudShader client:only="react" cloud={{ speed: 3 }} />
      </div>

      <!-- Keep the wave shader inside the hero stack, beneath the cloud panel
           and the laptop/content layers. -->
      <div data-hero-wave data-shader-active="true" class="pointer-events-none fixed inset-0 z-[-3] h-[100dvh] w-full overflow-hidden bg-[#05050b] will-change-opacity">
        <div
          class="absolute inset-0 rotate-180"
          style="mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%);"
        >
          <WaveShaderBackground client:only="react" className="h-full w-full" />
        </div>
      </div>

      <div class="relative z-20 mx-auto flex max-w-[1200px] flex-col items-center px-[20px] pt-[188px] pb-0">
        <h1 class="site-heading m-0 text-center text-ink-800 mb-[68px]">
          Animate the thing<br />you're trying to explain.
        </h1>
        <MacbookScrollDemo client:only="react" />
      </div>
    </section>

    <section id="story" class="relative z-10 bg-ink-900 pt-[96px] md:pt-[120px] pb-0">
      <div class="max-w-[1200px] mx-auto px-[clamp(20px,5vw,120px)] flex flex-col md:grid md:grid-cols-12 gap-[24px] md:gap-[24px]">
        <div class="md:col-span-6 w-full">
          <p data-brighten class="m-0 font-display text-[clamp(28px,2.9vw,40px)] leading-[1.12] tracking-[-0.01em]">
            I spent more time learning animation tools than animating.
          </p>
        </div>
        <div class="md:col-span-5 md:col-start-8 mt-[56px] md:mt-[96px] w-full">
          <p data-brighten class="m-0 font-display text-[clamp(28px,2.9vw,40px)] leading-[1.12] tracking-[-0.01em]">
            LAO is the tool I wanted.
          </p>
          <p class="mt-[26px] mb-0 text-[18px] leading-[1.6] max-w-[60ch] text-text">
            Two modes — continuous line and stop motion. A canvas, a pen, and a timeline that's already running. Almost nothing to learn.
          </p>
        </div>
      </div>
    </section>

    <!-- The canvas is sticky and can occupy the viewport at the seam with the
         next section, so give this whole scroll stage its own higher layer. -->
    <section id="cards-scroll" class="relative z-30 h-[300vh] overflow-visible bg-ink-900">
      <!-- Background gradient for the scroll section -->
      <div class="absolute inset-0 z-0 pointer-events-none bg-ink-900">
      </div>
      <!-- Cards sit on top with transparent canvas -->
      <ThreeScrollCards client:visible />
    </section>

    <!-- The two mode cards are intentionally separate from the ThreeScrollCards
         stage above. This section owns the mirrored cube scene and its text reveal. -->
    <ModeCubeSection client:load />

    <section class="relative z-10 bg-ink-900 pt-[150px] pb-[160px] overflow-x-clip">
      <div class="relative max-w-[1200px] mx-auto px-[clamp(20px,5vw,120px)]">
        <h2 class="site-heading m-0 mb-[90px] text-center text-text-hi">
          It's a file. You keep it.
        </h2>

        <!-- The component paints its own page background (bg-white / dark:bg-black),
             which would sit as a slab on top of this section. `dark:` here resolves
             from the visitor's OS setting, not the site, so it is neutralised
             rather than relied on. -->
        <HowItWorks
          client:visible
          className="bg-transparent! px-0!"
          features={[
            {
              title: 'Work on it',
              description: "Open the canvas and draw. It's already moving.",
              colorTheme: 'orange',
            },
            {
              title: 'Save it',
              description: 'One file. .lao. On your machine, in your folder.',
              colorTheme: 'blue',
            },
            {
              title: 'Open it',
              description: "Any machine, online or off. It'll still open in ten years.",
              colorTheme: 'purple',
            },
            {
              title: 'Share it',
              description: 'Export to MP4, WebM, or GIF. Drop it in a deck, a site, a group chat.',
              colorTheme: 'orange',
            },
          ]}
        />

      </div>
    </section>

    <PicturaAudienceSection client:visible />

    <section class="relative z-20 isolate bg-ink-900 pt-[160px] pb-[150px] overflow-hidden">
      <div class="max-w-[1200px] mx-auto px-[clamp(20px,5vw,120px)]">
        <div class="relative flex flex-col md:flex-row items-end min-h-0 md:min-h-[640px] rounded-[28px] md:rounded-[59px] bg-paper overflow-hidden">
          <img data-wipe data-wipe-slow src={palmUrl} alt="Hand-drawn open palm" class="block md:absolute md:right-[-2%] md:top-[6%] w-[80%] md:w-[66%] h-auto mx-auto md:mx-0 relative inset-auto" />
          <div class="p-[28px_22px_36px] md:p-[56px] max-w-[620px]">
            <h2 class="site-heading m-0 mb-[20px] text-ink-800">
              Designed screen by screen, not prompted.
            </h2>
            <p class="m-0 text-[17px] leading-[1.6] max-w-[56ch] text-[#3E4A5C]">
              Every screen, flow, and interaction designed by hand in Paper, on a small design system built from fluid functionalism, beUI, and chanhdai. AI can help you build. It can't draw your map.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="waitlist" class="relative z-10 bg-ink-900 pt-[160px] pb-[200px] overflow-x-clip">
      <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-ink-900 from-0% via-ink-900/25 via-32% via-ink-900/25 via-68% to-ink-900 to-100%"></div>
      <div class="relative z-10 mx-auto max-w-[1200px] rounded-[28px] md:rounded-[59px] bg-ink-800 px-[clamp(20px,5vw,120px)] py-[56px] md:py-[76px] text-center shadow-2xl">
       <div class="mx-auto max-w-[800px]">
        <h2 class="site-heading m-0 mb-[16px] text-text-hi">
          Get in early. Take a good username.
        </h2>
        <p class="m-0 mb-[46px] text-[17px] leading-[1.6] text-text max-w-[620px] mx-auto">
          Early access goes out in waves. Tell me what you'd animate and you'll be in an earlier one.
        </p>

        <!-- Waitlist Form Island -->
        <div id="waitlist-form-container" class="max-w-[680px] mx-auto">
          <form method="POST" action="/api/waitlist" class="flex flex-col gap-[22px] text-left">
            <div class="flex flex-col gap-[8px]">
              <label for="lao-username" class="sr-only">Username</label>
              <div class="flex-1 min-w-0">
                <GooeyInput
                  client:visible
                  id="lao-username"
                  name="username"
                  required
                  autoComplete="off"
                  placeholder="Username"
                  showPlaceholderWhenCollapsed
                  className="w-full justify-start"
                  collapsedWidth="100%"
                  expandedWidth="calc(100% - 64px)"
                  iconName="username"
                />
              </div>
            </div>

            <div class="flex flex-col gap-[8px]">
              <label for="lao-email" class="sr-only">Email</label>
              <div class="flex-1 min-w-0">
                <GooeyInput
                  client:visible
                  id="lao-email"
                  name="email"
                  type="email"
                  required
                  placeholder="Email"
                  showPlaceholderWhenCollapsed
                  className="w-full justify-start"
                  collapsedWidth="100%"
                  expandedWidth="calc(100% - 64px)"
                  iconName="email"
                />
              </div>
            </div>

            <div class="flex flex-col gap-[8px]">
              <label for="lao-first" class="sr-only">What would you animate first?</label>
              <div class="flex-1 min-w-0">
                <GooeyInput
                  client:visible
                  id="lao-first"
                  name="first_animation"
                  placeholder="What would you animate first?"
                  showPlaceholderWhenCollapsed
                  className="w-full justify-start"
                  collapsedWidth="100%"
                  expandedWidth="calc(100% - 64px)"
                  iconName="animation"
                />
              </div>
            </div>

            <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute left-[-9999px] w-[1px] h-[1px] opacity-0" />

            <GradientHoverButton
              client:load
              type="submit"
              background="linear-gradient(in oklab 180deg, oklab(0% 0 0) 0%, oklab(48.5% -0.018 -0.082) 100%)"
              hoverBackground="linear-gradient(in oklab 180deg, oklab(10% 0 -0.01) 0%, oklab(58% -0.03 -0.13) 100%)"
              borderColor="#292A2A"
              hoverBorderColor="#363636"
              className="mt-[6px] p-[16px] w-full rounded-full text-text-hi font-mono text-[13px] tracking-[0.08em] uppercase shadow-[0_4px_14px_0_rgba(0,0,0,0.39)]"
            >
              Claim my spot
            </GradientHoverButton>

            <p class="m-0 mt-[6px] text-[14px] leading-[1.6] text-text-mid text-center">
              No spam. One email when it's ready, and the occasional build update you can leave anytime.
            </p>
          </form>
        </div>
        </div>
      </div>
    </section>

    <Footer client:visible />
  </div>
</Base>

<script>
  let disposePageEffects = () => {};

  const setupPageEffects = () => {
    disposePageEffects();

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const controller = new AbortController();
    const { signal } = controller;
    let navFrame = 0;
    let waveFrame = 0;

    // Nav blur scroll effect
    const nav = document.getElementById('main-nav');
    if (nav) {
      let compact: boolean | null = null;
      const updateNav = () => {
        navFrame = 0;
        const nextCompact = window.scrollY > 80;
        if (nextCompact === compact) return;
        compact = nextCompact;

        if (nextCompact) {
          nav.classList.replace('py-[9px]', 'py-[6px]');
          nav.classList.replace('pr-[10px]', 'pr-[8px]');
          nav.classList.replace('pl-[24px]', 'pl-[20px]');
          nav.classList.replace('bg-ink-800/78', 'bg-ink-800/94');
          nav.classList.replace('backdrop-blur-md', 'backdrop-blur-xl');
        } else {
          nav.classList.replace('py-[6px]', 'py-[9px]');
          nav.classList.replace('pr-[8px]', 'pr-[10px]');
          nav.classList.replace('pl-[20px]', 'pl-[24px]');
          nav.classList.replace('bg-ink-800/94', 'bg-ink-800/78');
          nav.classList.replace('backdrop-blur-xl', 'backdrop-blur-md');
        }
      };
      const requestNavUpdate = () => {
        if (!navFrame) navFrame = requestAnimationFrame(updateNav);
      };
      window.addEventListener('scroll', requestNavUpdate, { passive: true, signal });
      updateNav();
    }

    // Hold the wave in the viewport for the first 90vh of hero travel, then
    // dissolve it during the next 59vh. Direct style updates are batched into
    // one animation frame to avoid adding work to every scroll event.
    const waveStage = document.querySelector<HTMLElement>('[data-hero-wave-stage]');
    const wave = document.querySelector<HTMLElement>('[data-hero-wave]');
    if (waveStage && wave && !reduced) {
      const updateWaveFade = () => {
        waveFrame = 0;
        const travelled = Math.max(0, -waveStage.getBoundingClientRect().top);
        const holdDistance = window.innerHeight * 0.9;
        const fadeDistance = window.innerHeight * 0.59;
        const progress = Math.min(1, Math.max(0, (travelled - holdDistance) / fadeDistance));
        wave.style.opacity = String(1 - progress);
        const shaderActive = progress < 0.999;
        wave.dataset.shaderActive = String(shaderActive);
        wave.style.visibility = shaderActive ? 'visible' : 'hidden';
      };
      const requestWaveFade = () => {
        if (!waveFrame) waveFrame = requestAnimationFrame(updateWaveFade);
      };
      window.addEventListener('scroll', requestWaveFade, { passive: true, signal });
      window.addEventListener('resize', requestWaveFade, { passive: true, signal });
      requestWaveFade();
    }

    disposePageEffects = () => {
      controller.abort();
      cancelAnimationFrame(navFrame);
      cancelAnimationFrame(waveFrame);
    };
  };

  setupPageEffects();
  document.addEventListener('astro:page-load', setupPageEffects);
</script>
